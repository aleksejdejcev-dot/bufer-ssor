# ==============================================================================
# «Буфер Ссор» — Переменные окружения (Шаблон)
# Скопируйте этот файл в .env и укажите ваши параметры
# ВНИМАНИЕ: файл .env добавлен в .gitignore и никогда не должен попадать в репозиторий!
# ==============================================================================

# ==============================================================================
# База данных PostgreSQL (локальный Docker или российский облачный хостинг)
# ==============================================================================
# Переменные инициализации контейнера PostgreSQL (пароли генерировать: openssl rand -base64 24)
POSTGRES_USER=buffer_admin
POSTGRES_PASSWORD=<придумай_пароль>
POSTGRES_DB=buffer_ssor
MIGRATOR_PASSWORD=<придумай_пароль>
APP_USER_PASSWORD=<придумай_пароль>

# Строки подключения к БД (формат: postgresql://[user]:[password]@[host]:[port]/[dbname])
DATABASE_URL=postgresql://app_user:<придумай_пароль>@127.0.0.1:5432/buffer_ssor
# Тестовые базы данных (имя ОБЯЗАНО оканчиваться на _test, хост только 127.0.0.1/localhost)
DATABASE_URL_TEST=postgresql://buffer_admin:<придумай_пароль>@127.0.0.1:5432/buffer_ssor_test
DATABASE_URL_APP_TEST=postgresql://app_user:<придумай_пароль>@127.0.0.1:5432/buffer_ssor_test

# Режим проверки TLS для БД:
# disable - допустим ТОЛЬКО для локального Docker
# require / verify-ca / verify-full - обязательны для ENVIRONMENT=production
DB_SSLMODE=disable
# Путь к корневому сертификату провайдера БД (опционально для verify-ca / verify-full)
DB_SSL_ROOT_CERT=
DB_POOL_MIN=2
DB_POOL_MAX=10

# Срок хранения платёжных записей в годах
PAYMENT_RETENTION_YEARS=4

# Telegram Bot & Webhook / Long Polling
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_random_hex_string
# Оставьте WEBHOOK_BASE_URL пустым (или 'polling') для Long Polling, либо укажите URL для Webhook
WEBHOOK_BASE_URL=
TELEGRAM_API_BASE_URL=https://tg-proxy.aleksejdejcev62.workers.dev

# ==============================================================================
# ИИ-провайдер
# ==============================================================================
LLM_PROVIDER=gigachat

# Сбер GigaChat
# Авторизационные данные Base64 (Client ID + Client Secret из кабинета Сбер Салют)
GIGACHAT_CREDENTIALS=your_gigachat_auth_key_base64_here
# Область видимости: GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B (ИП/юрлица) | GIGACHAT_API_CORP (корпоративные)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Основная модель по умолчанию (не хардкодить!)
GIGACHAT_MODEL=GigaChat-3-Ultra
# Путь к доверенному корневому сертификату Минцифры РФ для TLS-соединений
GIGACHAT_CA_BUNDLE=backend/certs/russian_trusted_root_ca.pem
# Лимит параллельных запросов
GIGACHAT_CONCURRENCY=2
# Режим компактных промптов: standard (полные с правилами) | compact (сокращенные без примеров)
GIGACHAT_PROMPT_MODE=standard
# Только для локальной отладки (отключение проверки TLS). В продакшене строго 0!
GIGACHAT_INSECURE=0

# Опциональный сетевой прокси
HTTPS_PROXY=

# Модели для конкретных ролей пайплайна (опционально, если пусто — используется общая модель провайдера)
ANALYZER_MODEL=
CARD_MODEL=
SHARED_MODEL=
CHECKER_MODEL=

# Температуры шагов генерации
ANALYZER_TEMPERATURE=0.3
CARD_WRITER_TEMPERATURE=0.8
SHARED_WRITER_TEMPERATURE=0.7
LEAK_CHECKER_TEMPERATURE=0.0

# ==============================================================================
# Безопасность и шифрование исходников конфликтов (Fernet)
# ==============================================================================
# Генерация ключа: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INPUT_ENCRYPTION_KEY=your_fernet_32_byte_base64_encoded_key_here

# Telegram Mini App URL (отображается внутри Telegram)
MINI_APP_URL=https://bufer-ssor.ru
MINIAPP_URL=https://bufer-ssor.ru

# Окружение (production | development)
ENVIRONMENT=production

# Секретный ключ для хэширования идентификаторов плательщиков (HMAC-SHA256)
PAYMENT_HASH_KEY=your_payment_hash_secret_key_here

# Платежи (Yookassa) — по умолчанию выключено для MVP
ENABLE_YOOKASSA=false
